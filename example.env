# ============================================================
# CineBook - environment template
# ------------------------------------------------------------
# 1. Copy this file to .env
# 2. Replace every {{PLACEHOLDER}} with your real values
# 3. Never commit .env (it contains secrets)
# ============================================================

# MongoDB Atlas connection string (SRV)
# Create a DB user in Atlas -> Database Access, then paste the URI here.
MONGODB_URI=mongodb+srv://{{USER}}:{{PASSWORD}}@{{CLUSTER}}.mongodb.net

# Database name used by seed scripts and the API
MONGODB_DB=cinebook

# ------------------------------------------------------------
# Confluent Cloud (needed later for Part E - CDC consumer)
# ------------------------------------------------------------
KAFKA_BOOTSTRAP={{BOOTSTRAP_SERVERS}}
KAFKA_API_KEY={{KAFKA_API_KEY}}
KAFKA_API_SECRET={{KAFKA_API_SECRET}}

# Topic produced by the MongoDB Atlas Source connector
KAFKA_TOPIC=cdc.cinebook.bookings

# Consumer group. A new group reads the topic from the beginning.
KAFKA_GROUP_ID=cinebook-cdc-consumer
